{
    "name": "@tessellatepos/sdk",
    "version": "0.1.0",
    "type": "module",
    "main": "lib/src/index.js",
    "types": "lib/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/src/index.d.ts",
            "default": "./lib/src/index.js"
        }
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "build": "tsc -b",
        "lint": "prettier . && eslint .",
        "lint:fix": "prettier . --write && eslint . --fix",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx,html}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com/"
    },
    "devDependencies": {
        "@types/node": "^24.10.9",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "husky": "^9.1.7",
        "jiti": "^2.6.1",
        "prettier": "^3.8.1",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.46.4"
    }
}
