{
    "name": "@tessellatepos/sdk",
    "version": "0.0.2-alpha",
    "type": "module",
    "main": "lib/src/index.js",
    "types": "lib/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/src/index.d.ts",
            "default": "./lib/src/index.js"
        }
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "build": "tsc -b",
        "build:data": "node data/scripts/build-countries.mjs && node data/scripts/build-currencies.mjs",
        "fetch:data": "node data/scripts/fetch-address-formats.mjs",
        "lint": "prettier . && eslint .",
        "lint:fix": "prettier . --write && eslint . --fix",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx,html}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com/"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^24.10.9",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.11.0",
        "husky": "^9.1.7",
        "jiti": "^2.6.1",
        "prettier": "^3.9.6",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.68.0"
    }
}
