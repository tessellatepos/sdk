{
    "compilerOptions": {
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "outDir": "lib",
        "module": "NodeNext",
        "target": "es2020",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist", "lib"]
}
